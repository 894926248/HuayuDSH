{
  "name": "dsh-peak-valley",
  "version": "0.1.0",
  "description": "Peak and valley electricity period display with a live 24-hour progress bar.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": { "default": "./lib/client-bundle.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
