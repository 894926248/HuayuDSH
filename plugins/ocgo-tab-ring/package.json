{
  "name": "ocgo-tab-ring",
  "version": "0.1.3",
  "description": "OpenCodeGo / Command Code 额度状态环：显示在侧栏设置右侧，点击打开同一悬浮窗用量数据。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client-opencodego.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client-opencodego.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
